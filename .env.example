# APIC ProtoHub Environment Configuration Template
# Copy this file to .env and adjust variables as necessary for your local environment.
# DO NOT COMMIT REAL PRODUCTION SECRETS OR PASSWORDS.

# Application Server
PORT=3000
NODE_ENV=development
DEMO_MODE=true

# Database Connection (Dedicated Local PostgreSQL Cluster)
DATABASE_URL=postgresql://postgres@localhost:5433/protohub
PGHOST=localhost
PGPORT=5433
PGUSER=postgres
PGPASSWORD=
PGDATABASE=protohub

# Session Security
SESSION_SECRET=placeholder_session_secret_change_in_production_min_32_characters

# Private Storage Configuration
UPLOAD_DIR=uploads

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
